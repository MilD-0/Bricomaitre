{
  "name": "storefront-api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "build:worker": "node ../ops/scripts/build-worker.mjs storefront-api/scripts/run-meta-worker.ts storefront-api/dist/run-meta-worker.cjs",
    "start": "node ../ops/scripts/start-next-standalone.mjs --app-dir . --nested-dir storefront-api --default-port 3001",
    "worker:meta": "tsx scripts/run-meta-worker.ts",
    "lint": "eslint",
    "test": "vitest run --project unit && vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@bric/db": "workspace:*",
    "@bric/runtime": "workspace:*",
    "@bric/storefront-core": "workspace:*",
    "@aws-sdk/client-s3": "^3.909.0",
    "@sentry/nextjs": "10.47.0",
    "@sentry/node": "10.47.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "jsdom": "^28.1.0",
    "msw": "^2.12.14",
    "typescript": "5.9.3",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  }
}
