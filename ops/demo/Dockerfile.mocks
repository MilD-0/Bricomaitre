FROM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54

LABEL org.opencontainers.image.source="https://github.com/MilD-0/Bricomaitre"

WORKDIR /app
ENV NODE_ENV=production

RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && groupadd --gid 10001 demo \
  && useradd --uid 10001 --gid demo --home-dir /app --shell /usr/sbin/nologin --no-create-home demo

COPY --chown=demo:demo mock-*.mjs ./
COPY --chown=demo:demo data/algeria-wilayas.json data/algeria-communes.json data/DZShip-LICENSE.txt ./data/

USER demo
EXPOSE 8080
CMD ["node", "mock-services.mjs"]
