{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "AWS": ["*"] },
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::bricomaitre-demo/products/*",
        "arn:aws:s3:::bricomaitre-demo/brands/*",
        "arn:aws:s3:::bricomaitre-demo/categories/*",
        "arn:aws:s3:::bricomaitre-demo/banners/*",
        "arn:aws:s3:::bricomaitre-demo/exports/products/*"
      ]
    }
  ]
}
