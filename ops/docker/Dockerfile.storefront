FROM node:20-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY adminstration/package.json adminstration/package.json
COPY storefront-api/package.json storefront-api/package.json
COPY storefront/package.json storefront/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY packages/storefront-core/package.json packages/storefront-core/package.json
COPY storefront/app/components/package.json storefront/app/components/package.json

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm --filter storefront build

FROM node:20-bookworm-slim AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3002
ENV HOSTNAME=0.0.0.0

COPY --from=base /workspace/storefront/.next/standalone ./
COPY --from=base /workspace/storefront/.next/static ./storefront/.next/static
COPY --from=base /workspace/storefront/public ./storefront/public

EXPOSE 3002

CMD ["node", "storefront/server.js"]
