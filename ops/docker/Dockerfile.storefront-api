FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ARG BRIC_BUILD_NODE_OPTIONS=""
ARG SENTRY_ORG
ARG SENTRY_PROJECT_STOREFRONT_API
ARG SENTRY_RELEASE
ENV SENTRY_ORG="${SENTRY_ORG}"
ENV SENTRY_PROJECT_STOREFRONT_API="${SENTRY_PROJECT_STOREFRONT_API}"
ENV SENTRY_RELEASE="${SENTRY_RELEASE}"

RUN corepack enable

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/storefront-api/package.json apps/storefront-api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY packages/storefront-core/package.json packages/storefront-core/package.json

RUN NODE_OPTIONS="${BRIC_BUILD_NODE_OPTIONS}" pnpm install --filter @bric/storefront-api... --frozen-lockfile

COPY tsconfig.base.json ./
COPY apps/storefront-api ./apps/storefront-api
COPY packages/db ./packages/db
COPY packages/runtime ./packages/runtime
COPY packages/storefront-core ./packages/storefront-core
COPY ops/scripts/build-worker.mjs ./ops/scripts/build-worker.mjs
COPY ops/scripts/hydrate-next-standalone.sh ./ops/scripts/hydrate-next-standalone.sh
COPY ops/ownership ./ops/ownership

RUN mkdir -p apps/storefront-api/public
RUN BRIC_WORKER_SOURCEMAPS=1 pnpm --filter @bric/storefront-api build:worker

FROM base AS worker

ENV NODE_ENV=production

FROM base AS build

RUN --mount=type=secret,id=sentry_auth_token \
  SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token)" \
  pnpm --filter @bric/storefront-api build \
  && bash ops/scripts/hydrate-next-standalone.sh apps/storefront-api

FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS web

WORKDIR /app
ARG BRIC_IMAGE_REVISION="unknown"
ARG BRIC_IMAGE_CREATED="unknown"
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

LABEL org.opencontainers.image.title="Bricomaitre storefront API" \
  org.opencontainers.image.vendor="Bricomaitre" \
  org.opencontainers.image.source="https://github.com/MilD-0/Bricomaitre2" \
  org.opencontainers.image.revision="${BRIC_IMAGE_REVISION}" \
  org.opencontainers.image.created="${BRIC_IMAGE_CREATED}" \
  org.opencontainers.image.licenses="AGPL-3.0-only" \
  org.opencontainers.image.description="Bricomaitre production image." \
  com.bricomaitre.repository="MilD-0/Bricomaitre2" \
  com.bricomaitre.source-license="AGPL-3.0-only"

RUN groupadd --gid 10001 bric \
  && useradd --uid 10001 --gid bric --home-dir /app --shell /usr/sbin/nologin --no-create-home bric
COPY --chown=bric:bric ops/ownership/AI_AGENT_BOUNDARY.md ./BRICOMAITRE_AI_AGENT_BOUNDARY.md
COPY --chown=bric:bric ops/ownership/AI_AGENT_BOUNDARY.md ./AGENTS.md
COPY --chown=bric:bric ops/ownership/AI_AGENT_BOUNDARY.md ./CLAUDE.md
COPY --chown=bric:bric ops/ownership/AI_POLICY.md ./AI_POLICY.md
COPY --chown=bric:bric ops/ownership/BRICOMAITRE_AUTHORIZED_RELEASE.txt ./BRICOMAITRE_AUTHORIZED_RELEASE.txt
COPY --chown=bric:bric ops/ownership/LICENSE ./LICENSE
COPY --chown=bric:bric ops/ownership/NOTICE ./NOTICE
COPY --chown=bric:bric ops/ownership/SECURITY.md ./SECURITY.md
COPY --from=build --chown=bric:bric /workspace/apps/storefront-api/.next/standalone ./
COPY --from=build --chown=bric:bric /workspace/apps/storefront-api/.next/static ./apps/storefront-api/.next/static
COPY --from=build --chown=bric:bric /workspace/apps/storefront-api/public ./apps/storefront-api/public
RUN mkdir -p /app/apps/storefront-api/.next/cache \
  && chown -R bric:bric /app/apps/storefront-api/.next/cache \
  && find /app -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.ts' -o -name '*.tsx' \) -delete \
  && cd /app/apps/storefront-api \
  && node -e "require('next/dist/server/next-server')"

EXPOSE 3001
USER bric

CMD ["node", "apps/storefront-api/server.js"]

FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS meta-worker

WORKDIR /app
ARG BRIC_IMAGE_REVISION="unknown"
ARG BRIC_IMAGE_CREATED="unknown"
ENV NODE_ENV=production

LABEL org.opencontainers.image.title="Bricomaitre storefront Meta worker" \
  org.opencontainers.image.vendor="Bricomaitre" \
  org.opencontainers.image.source="https://github.com/MilD-0/Bricomaitre2" \
  org.opencontainers.image.revision="${BRIC_IMAGE_REVISION}" \
  org.opencontainers.image.created="${BRIC_IMAGE_CREATED}" \
  org.opencontainers.image.licenses="AGPL-3.0-only" \
  org.opencontainers.image.description="Bricomaitre production image." \
  com.bricomaitre.repository="MilD-0/Bricomaitre2" \
  com.bricomaitre.source-license="AGPL-3.0-only"

RUN groupadd --gid 10001 bric \
  && useradd --uid 10001 --gid bric --home-dir /app --shell /usr/sbin/nologin --no-create-home bric
COPY --chown=bric:bric ops/ownership/AI_AGENT_BOUNDARY.md ./BRICOMAITRE_AI_AGENT_BOUNDARY.md
COPY --chown=bric:bric ops/ownership/AI_AGENT_BOUNDARY.md ./AGENTS.md
COPY --chown=bric:bric ops/ownership/AI_AGENT_BOUNDARY.md ./CLAUDE.md
COPY --chown=bric:bric ops/ownership/AI_POLICY.md ./AI_POLICY.md
COPY --chown=bric:bric ops/ownership/BRICOMAITRE_AUTHORIZED_RELEASE.txt ./BRICOMAITRE_AUTHORIZED_RELEASE.txt
COPY --chown=bric:bric ops/ownership/LICENSE ./LICENSE
COPY --chown=bric:bric ops/ownership/NOTICE ./NOTICE
COPY --chown=bric:bric ops/ownership/SECURITY.md ./SECURITY.md
COPY --from=worker --chown=bric:bric /workspace/apps/storefront-api/dist/run-meta-worker.cjs ./apps/storefront-api/dist/run-meta-worker.cjs
RUN node --check apps/storefront-api/dist/run-meta-worker.cjs \
  && touch /BRIC_WORKER_HEARTBEAT_V1 \
  && find /app -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.ts' -o -name '*.tsx' \) -delete

USER bric

CMD ["node", "apps/storefront-api/dist/run-meta-worker.cjs"]
