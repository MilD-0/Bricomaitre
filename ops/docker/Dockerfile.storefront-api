FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS base

ENV PNPM_HOME="/pnpm"
ENV COREPACK_HOME="/corepack"
ENV PATH="$PNPM_HOME:$PATH"
ARG BRIC_BUILD_NODE_OPTIONS=""
ARG SENTRY_ORG
ARG SENTRY_PROJECT_STOREFRONT_API
ARG SENTRY_RELEASE
ENV SENTRY_ORG="${SENTRY_ORG}"
ENV SENTRY_PROJECT_STOREFRONT_API="${SENTRY_PROJECT_STOREFRONT_API}"
ENV SENTRY_RELEASE="${SENTRY_RELEASE}"

RUN corepack enable

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/storefront-api/package.json apps/storefront-api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY packages/storefront-core/package.json packages/storefront-core/package.json

RUN --mount=type=cache,id=bricomaitre-corepack-pnpm-11.24.0,target=/corepack,sharing=shared \
  --mount=type=cache,id=bricomaitre-pnpm-store-v11,target=/pnpm/store,sharing=shared \
  npm_config_store_dir=/pnpm/store \
  npm_config_prefer_offline=true \
  npm_config_fetch_retries=8 \
  npm_config_fetch_retry_factor=2 \
  npm_config_fetch_retry_mintimeout=1000 \
  npm_config_fetch_retry_maxtimeout=60000 \
  NODE_OPTIONS="${BRIC_BUILD_NODE_OPTIONS}" \
  pnpm install --filter @bric/storefront-api... --frozen-lockfile

COPY tsconfig.base.json ./
COPY apps/storefront-api ./apps/storefront-api
COPY packages/db ./packages/db
COPY packages/runtime ./packages/runtime
COPY packages/storefront-core ./packages/storefront-core
COPY ops/scripts/build-worker.mjs ./ops/scripts/build-worker.mjs
COPY ops/scripts/generate-runtime-license-bundle.mjs ./ops/scripts/generate-runtime-license-bundle.mjs
COPY ops/scripts/hydrate-next-standalone.sh ./ops/scripts/hydrate-next-standalone.sh
COPY third_party/licenses ./third_party/licenses

RUN mkdir -p apps/storefront-api/public
RUN --mount=type=cache,id=bricomaitre-corepack-pnpm-11.24.0,target=/corepack,sharing=shared \
  pnpm_config_verify_deps_before_run=false \
  BRIC_WORKER_SOURCEMAPS=1 pnpm --filter @bric/storefront-api build:worker

FROM base AS worker

ENV NODE_ENV=production

FROM base AS build

# Next.js otherwise sizes page workers from the host CPU count.
ARG BRIC_BUILD_CPUS=""
RUN --mount=type=cache,id=bricomaitre-corepack-pnpm-11.24.0,target=/corepack,sharing=shared \
  --mount=type=cache,id=bricomaitre-storefront-api-next-build,target=/workspace/apps/storefront-api/.next/cache,sharing=locked \
  --mount=type=secret,id=sentry_auth_token \
  pnpm_config_verify_deps_before_run=false \
  CIRCLE_NODE_TOTAL="${BRIC_BUILD_CPUS}" \
  SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token)" \
  pnpm --filter @bric/storefront-api build \
  && bash ops/scripts/hydrate-next-standalone.sh apps/storefront-api \
  && node ops/scripts/generate-runtime-license-bundle.mjs \
    node_modules \
    apps/storefront-api/.next/standalone/RUNTIME_THIRD_PARTY_LICENSES.txt \
    apps/storefront-api/.next/standalone

FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS web

WORKDIR /app
ARG BRIC_IMAGE_REVISION="unknown"
ARG BRIC_IMAGE_CREATED="unknown"
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

LABEL org.opencontainers.image.title="Bricomaitre storefront API" \
  org.opencontainers.image.vendor="Bricomaitre" \
  org.opencontainers.image.source="https://github.com/MilD-0/Bricomaitre" \
  org.opencontainers.image.revision="${BRIC_IMAGE_REVISION}" \
  org.opencontainers.image.created="${BRIC_IMAGE_CREATED}" \
  org.opencontainers.image.licenses="AGPL-3.0-only" \
  org.opencontainers.image.description="Bricomaitre public storefront API runtime." \
  com.bricomaitre.repository="MilD-0/Bricomaitre"

RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && groupadd --gid 10001 bric \
  && useradd --uid 10001 --gid bric --home-dir /app --shell /usr/sbin/nologin --no-create-home bric
COPY --chown=bric:bric LICENSE NOTICE ./
COPY --chown=bric:bric third_party/licenses ./third_party/licenses
COPY --from=build --chown=bric:bric /workspace/apps/storefront-api/.next/standalone ./
COPY --from=build --chown=bric:bric /workspace/apps/storefront-api/.next/static ./apps/storefront-api/.next/static
COPY --from=build --chown=bric:bric /workspace/apps/storefront-api/public ./apps/storefront-api/public
RUN mkdir -p /app/apps/storefront-api/.next/cache \
  && chown -R bric:bric /app/apps/storefront-api/.next/cache \
  && find /app -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.ts' -o -name '*.tsx' \) -delete \
  && cd /app/apps/storefront-api \
  && node -e "require('next/dist/server/next-server')"

EXPOSE 3001
USER bric

CMD ["node", "apps/storefront-api/server.js"]

FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS meta-worker

WORKDIR /app
ARG BRIC_IMAGE_REVISION="unknown"
ARG BRIC_IMAGE_CREATED="unknown"
ENV NODE_ENV=production

LABEL org.opencontainers.image.title="Bricomaitre storefront Meta worker" \
  org.opencontainers.image.vendor="Bricomaitre" \
  org.opencontainers.image.source="https://github.com/MilD-0/Bricomaitre" \
  org.opencontainers.image.revision="${BRIC_IMAGE_REVISION}" \
  org.opencontainers.image.created="${BRIC_IMAGE_CREATED}" \
  org.opencontainers.image.licenses="AGPL-3.0-only" \
  org.opencontainers.image.description="Bricomaitre marketing event worker runtime." \
  com.bricomaitre.repository="MilD-0/Bricomaitre"

RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && groupadd --gid 10001 bric \
  && useradd --uid 10001 --gid bric --home-dir /app --shell /usr/sbin/nologin --no-create-home bric
COPY --chown=bric:bric LICENSE NOTICE ./
COPY --chown=bric:bric third_party/licenses ./third_party/licenses
COPY --from=worker --chown=bric:bric /workspace/apps/storefront-api/dist/run-meta-worker.cjs ./apps/storefront-api/dist/run-meta-worker.cjs
COPY --from=build --chown=bric:bric /workspace/apps/storefront-api/.next/standalone/RUNTIME_THIRD_PARTY_LICENSES.txt ./
RUN node --check apps/storefront-api/dist/run-meta-worker.cjs \
  && touch /BRIC_WORKER_HEARTBEAT_V1 \
  && find /app -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.ts' -o -name '*.tsx' \) -delete

USER bric

CMD ["node", "apps/storefront-api/dist/run-meta-worker.cjs"]
