FROM node:20-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ARG GOOGLE_CLIENT_ID
ARG GOOGLE_CLIENT_SECRET
ARG NEXTAUTH_URL
ARG NEXTAUTH_SECRET
ARG STOREFRONT_API_BASE_URL
ENV GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID}"
ENV GOOGLE_CLIENT_SECRET="${GOOGLE_CLIENT_SECRET}"
ENV NEXTAUTH_URL="${NEXTAUTH_URL}"
ENV NEXTAUTH_SECRET="${NEXTAUTH_SECRET}"
ENV STOREFRONT_API_BASE_URL="${STOREFRONT_API_BASE_URL}"

RUN corepack enable

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY adminstration/package.json adminstration/package.json
COPY storefront-api/package.json storefront-api/package.json
COPY storefront/package.json storefront/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY packages/storefront-core/package.json packages/storefront-core/package.json
COPY storefront/app/components/package.json storefront/app/components/package.json

RUN pnpm install --frozen-lockfile

COPY . .

FROM base AS build

RUN pnpm --filter adminstration build

FROM node:20-bookworm-slim AS web

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build /workspace/adminstration/.next/standalone ./
COPY --from=build /workspace/adminstration/.next/static ./adminstration/.next/static
COPY --from=build /workspace/adminstration/public ./adminstration/public

EXPOSE 3000

CMD ["node", "adminstration/server.js"]

FROM base AS worker

WORKDIR /workspace
ENV NODE_ENV=production

CMD ["pnpm", "--filter", "adminstration", "worker"]
