FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS base

ENV PNPM_HOME="/pnpm"
ENV COREPACK_HOME="/corepack"
ENV PATH="$PNPM_HOME:$PATH"
ARG BRIC_BUILD_NODE_OPTIONS=""
ARG GOOGLE_CLIENT_ID
ARG APPLICATION_ORIGIN
ARG STOREFRONT_API_BASE_URL
ARG NEXT_PUBLIC_SENTRY_DSN_ADMIN
ARG SENTRY_ORG
ARG SENTRY_PROJECT_ADMIN
ARG SENTRY_RELEASE
ENV GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID}"
ENV STOREFRONT_API_BASE_URL="${STOREFRONT_API_BASE_URL}"
ENV NEXT_PUBLIC_SENTRY_DSN_ADMIN="${NEXT_PUBLIC_SENTRY_DSN_ADMIN}"
ENV SENTRY_ORG="${SENTRY_ORG}"
ENV SENTRY_PROJECT_ADMIN="${SENTRY_PROJECT_ADMIN}"
ENV SENTRY_RELEASE="${SENTRY_RELEASE}"

RUN corepack enable

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/ai-core/package.json packages/ai-core/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY packages/storefront-core/package.json packages/storefront-core/package.json

RUN --mount=type=cache,id=bricomaitre-corepack-pnpm-11.24.0,target=/corepack,sharing=shared \
  --mount=type=cache,id=bricomaitre-pnpm-store-v11,target=/pnpm/store,sharing=shared \
  npm_config_store_dir=/pnpm/store \
  npm_config_prefer_offline=true \
  npm_config_fetch_retries=8 \
  npm_config_fetch_retry_factor=2 \
  npm_config_fetch_retry_mintimeout=1000 \
  npm_config_fetch_retry_maxtimeout=60000 \
  NODE_OPTIONS="${BRIC_BUILD_NODE_OPTIONS}" \
  pnpm install --filter @bric/admin... --frozen-lockfile

COPY tsconfig.base.json ./
COPY apps/admin ./apps/admin
COPY packages/ai-core ./packages/ai-core
COPY packages/db ./packages/db
COPY packages/runtime ./packages/runtime
COPY packages/storefront-core ./packages/storefront-core
COPY ops/scripts/build-worker.mjs ./ops/scripts/build-worker.mjs
COPY ops/scripts/generate-runtime-license-bundle.mjs ./ops/scripts/generate-runtime-license-bundle.mjs
COPY ops/scripts/hydrate-next-standalone.sh ./ops/scripts/hydrate-next-standalone.sh
COPY third_party/licenses ./third_party/licenses

FROM base AS build

# Next.js otherwise sizes page workers from the host CPU count.
ARG BRIC_BUILD_CPUS=""
RUN --mount=type=cache,id=bricomaitre-corepack-pnpm-11.24.0,target=/corepack,sharing=shared \
  --mount=type=cache,id=bricomaitre-admin-next-build,target=/workspace/apps/admin/.next/cache,sharing=locked \
  --mount=type=secret,id=google_client_secret \
  --mount=type=secret,id=better_auth_secret \
  --mount=type=secret,id=sentry_auth_token \
  export CIRCLE_NODE_TOTAL="${BRIC_BUILD_CPUS}" \
  GOOGLE_CLIENT_SECRET="$(cat /run/secrets/google_client_secret)" \
  BETTER_AUTH_SECRET="$(cat /run/secrets/better_auth_secret)" \
  BETTER_AUTH_URL="${APPLICATION_ORIGIN}" \
  SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token)" \
  && BRIC_WORKER_SOURCEMAPS=1 pnpm --filter @bric/admin build:worker \
  && pnpm --filter @bric/admin build:db-tasks \
  && pnpm --filter @bric/admin build \
  && bash ops/scripts/hydrate-next-standalone.sh apps/admin \
  && mkdir -p /runtime/node_modules \
  && cp -LR /workspace/apps/admin/node_modules/node-cron /runtime/node_modules/node-cron \
  && node ops/scripts/generate-runtime-license-bundle.mjs \
    node_modules \
    /runtime/RUNTIME_THIRD_PARTY_LICENSES.txt \
    apps/admin/.next/standalone \
    /runtime \
  && cp /runtime/RUNTIME_THIRD_PARTY_LICENSES.txt \
    apps/admin/.next/standalone/RUNTIME_THIRD_PARTY_LICENSES.txt

FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS web

WORKDIR /app
ARG BRIC_IMAGE_REVISION="unknown"
ARG BRIC_IMAGE_CREATED="unknown"
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

LABEL org.opencontainers.image.title="Bricomaitre admin web" \
  org.opencontainers.image.vendor="Bricomaitre" \
  org.opencontainers.image.source="https://github.com/MilD-0/Bricomaitre" \
  org.opencontainers.image.revision="${BRIC_IMAGE_REVISION}" \
  org.opencontainers.image.created="${BRIC_IMAGE_CREATED}" \
  org.opencontainers.image.licenses="AGPL-3.0-only" \
  org.opencontainers.image.description="Bricomaitre commerce administration runtime." \
  com.bricomaitre.repository="MilD-0/Bricomaitre"

RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && groupadd --gid 10001 bric \
  && useradd --uid 10001 --gid bric --home-dir /app --shell /usr/sbin/nologin --no-create-home bric
COPY --chown=bric:bric LICENSE NOTICE SECURITY.md ./
COPY --chown=bric:bric third_party/licenses ./third_party/licenses
COPY --from=build --chown=bric:bric /workspace/apps/admin/.next/standalone ./
COPY --from=build --chown=bric:bric /workspace/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build --chown=bric:bric /workspace/apps/admin/public ./apps/admin/public
RUN mkdir -p /app/apps/admin/.next/cache \
  && chown -R bric:bric /app/apps/admin/.next/cache \
  && find /app -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.ts' -o -name '*.tsx' \) -delete \
  && cd /app/apps/admin \
  && node -e "require('next/dist/server/next-server')"

EXPOSE 3000
USER bric

CMD ["node", "apps/admin/server.js"]

FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS worker

WORKDIR /app
ARG BRIC_IMAGE_REVISION="unknown"
ARG BRIC_IMAGE_CREATED="unknown"
ENV NODE_ENV=production

LABEL org.opencontainers.image.title="Bricomaitre admin worker" \
  org.opencontainers.image.vendor="Bricomaitre" \
  org.opencontainers.image.source="https://github.com/MilD-0/Bricomaitre" \
  org.opencontainers.image.revision="${BRIC_IMAGE_REVISION}" \
  org.opencontainers.image.created="${BRIC_IMAGE_CREATED}" \
  org.opencontainers.image.licenses="AGPL-3.0-only" \
  org.opencontainers.image.description="Bricomaitre background worker runtime." \
  com.bricomaitre.repository="MilD-0/Bricomaitre"

RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && groupadd --gid 10001 bric \
  && useradd --uid 10001 --gid bric --home-dir /app --shell /usr/sbin/nologin --no-create-home bric
COPY --chown=bric:bric LICENSE NOTICE SECURITY.md ./
COPY --chown=bric:bric third_party/licenses ./third_party/licenses
COPY --from=build --chown=bric:bric /runtime/node_modules ./node_modules
COPY --from=build --chown=bric:bric /runtime/RUNTIME_THIRD_PARTY_LICENSES.txt ./
COPY --from=build --chown=bric:bric /workspace/apps/admin/dist/run-background-workers.cjs ./apps/admin/dist/run-background-workers.cjs
RUN node --check apps/admin/dist/run-background-workers.cjs \
  && ADMIN_WORKER_BOOTSTRAP_CHECK=1 node apps/admin/dist/run-background-workers.cjs \
  && touch /BRIC_WORKER_HEARTBEAT_V1 \
  && find /app -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.ts' -o -name '*.tsx' \) -delete

USER bric

CMD ["node", "apps/admin/dist/run-background-workers.cjs"]

FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS migrations

WORKDIR /app
ARG BRIC_IMAGE_REVISION="unknown"
ARG BRIC_IMAGE_CREATED="unknown"
ENV NODE_ENV=production

LABEL org.opencontainers.image.title="Bricomaitre admin migrations" \
  org.opencontainers.image.vendor="Bricomaitre" \
  org.opencontainers.image.source="https://github.com/MilD-0/Bricomaitre" \
  org.opencontainers.image.revision="${BRIC_IMAGE_REVISION}" \
  org.opencontainers.image.created="${BRIC_IMAGE_CREATED}" \
  org.opencontainers.image.licenses="AGPL-3.0-only" \
  org.opencontainers.image.description="Bricomaitre database migration runtime." \
  com.bricomaitre.repository="MilD-0/Bricomaitre"

RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && groupadd --gid 10001 bric \
  && useradd --uid 10001 --gid bric --home-dir /app --shell /usr/sbin/nologin --no-create-home bric
COPY --chown=bric:bric LICENSE NOTICE SECURITY.md ./
COPY --chown=bric:bric third_party/licenses ./third_party/licenses
COPY --from=build --chown=bric:bric /workspace/apps/admin/dist/run-db-migrations.cjs ./apps/admin/dist/run-db-migrations.cjs
COPY --from=build --chown=bric:bric /workspace/apps/admin/dist/verify-db-migrations.cjs ./apps/admin/dist/verify-db-migrations.cjs
COPY --from=build --chown=bric:bric /workspace/apps/admin/dist/refresh-release-reporting.cjs ./apps/admin/dist/refresh-release-reporting.cjs
COPY --from=build --chown=bric:bric /workspace/apps/admin/drizzle ./drizzle
COPY --from=build --chown=bric:bric /runtime/RUNTIME_THIRD_PARTY_LICENSES.txt ./
RUN node --check apps/admin/dist/run-db-migrations.cjs \
  && node --check apps/admin/dist/verify-db-migrations.cjs \
  && node --check apps/admin/dist/refresh-release-reporting.cjs \
  && find /app -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.ts' -o -name '*.tsx' \) -delete

USER bric

CMD ["sh", "-lc", "case \"${ADMIN_DB_TASK:-verify}\" in verify) node apps/admin/dist/verify-db-migrations.cjs ;; migrate) node apps/admin/dist/run-db-migrations.cjs ;; refresh-reporting) node apps/admin/dist/refresh-release-reporting.cjs ;; *) echo \"unsupported ADMIN_DB_TASK: ${ADMIN_DB_TASK}\" >&2; exit 1 ;; esac"]
