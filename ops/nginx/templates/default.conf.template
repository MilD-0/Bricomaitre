map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Docker can assign a new address whenever an application container restarts.
# Variable-based proxy targets make Nginx use this resolver at request time;
# static proxy_pass hostnames are otherwise resolved only when Nginx loads.
resolver 127.0.0.11 ipv6=off valid=5s;
resolver_timeout 2s;

server {
  listen 80 default_server;
  server_name _;

  return 444;
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;

  ssl_reject_handshake on;
}

server {
  listen 80;
  server_name ${BRIC_API_DOMAIN} ${BRIC_ADMIN_DOMAIN} ${BRIC_STOREFRONT_SERVER_NAMES};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri =404;
    access_log off;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${BRIC_API_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${BRIC_API_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${BRIC_API_CERT_NAME}/privkey.pem;

  client_max_body_size 1m;
  add_header X-Request-ID $request_id always;
  set $storefront_api_upstream storefront-api-${BRIC_ACTIVE_SLOT}:3001;

  # The public API defines route handlers, not Server Actions. Reject probes
  # before Next.js attempts to resolve attacker-controlled action identifiers.
  if ($http_next_action != '') {
    return 400;
  }

  location / {
    # Replace the application correlation header at the proxy boundary so the
    # public response has one edge-owned request identifier.
    proxy_hide_header X-Request-ID;
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_connect_timeout 2s;
    proxy_pass http://$storefront_api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${BRIC_ADMIN_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${BRIC_ADMIN_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${BRIC_ADMIN_CERT_NAME}/privkey.pem;

  client_max_body_size 50m;
  add_header X-Request-ID $request_id always;
  set $admin_upstream admin-${BRIC_ACTIVE_SLOT}:3000;

  location / {
    # Keep response-header ownership explicit at the proxying context. This
    # avoids duplicate IDs when the application echoes the incoming value.
    proxy_hide_header X-Request-ID;
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_connect_timeout 2s;
    proxy_pass http://$admin_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${BRIC_STOREFRONT_SERVER_NAMES};

  ssl_certificate /etc/letsencrypt/live/${BRIC_STOREFRONT_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${BRIC_STOREFRONT_CERT_NAME}/privkey.pem;

  client_max_body_size 1m;
  add_header X-Request-ID $request_id always;
  set $storefront_upstream storefront-${BRIC_ACTIVE_SLOT}:3002;

  # The storefront defines route handlers, not Server Actions. Admin is the
  # only application allowed to receive legitimate Next-Action requests.
  if ($http_next_action != '') {
    return 400;
  }

  location / {
    proxy_hide_header X-Request-ID;
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_connect_timeout 2s;
    proxy_pass http://$storefront_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
