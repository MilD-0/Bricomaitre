map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

resolver 127.0.0.11 ipv6=off valid=30s;

server {
  listen 80;
  server_name ${BRIC_API_DOMAIN};

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 80;
  server_name ${BRIC_ADMIN_DOMAIN};

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 80;
  server_name ${BRIC_STOREFRONT_DOMAIN} ${BRIC_STOREFRONT_APEX_DOMAIN};

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${BRIC_API_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${BRIC_API_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${BRIC_API_CERT_NAME}/privkey.pem;

  client_max_body_size 10m;

  location / {
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_pass http://storefront-api-${BRIC_ACTIVE_SLOT}:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${BRIC_ADMIN_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${BRIC_ADMIN_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${BRIC_ADMIN_CERT_NAME}/privkey.pem;

  client_max_body_size 50m;

  location / {
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_pass http://adminstration-${BRIC_ACTIVE_SLOT}:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${BRIC_STOREFRONT_DOMAIN} ${BRIC_STOREFRONT_APEX_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${BRIC_STOREFRONT_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${BRIC_STOREFRONT_CERT_NAME}/privkey.pem;

  client_max_body_size 20m;

  location / {
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_pass http://storefront-${BRIC_ACTIVE_SLOT}:3002;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
