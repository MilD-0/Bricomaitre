NODE_ENV=production
PORT=3002
SITE_URL=https://bricomaitre.com
NEXT_PUBLIC_SITE_URL=https://bricomaitre.com
STOREFRONT_API_BASE_URL=http://storefront-api-blue:3001
AI_ENABLED=false
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# To use ExperientialLabs, set AI_PROVIDER=experientiallabs and EXPLABS_API_KEY.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://bricomaitre.com
OPENROUTER_APP_TITLE=Bricomaitre
AI_STOREFRONT_MODEL=openai/gpt-5.6-luna
AI_STOREFRONT_FALLBACK_MODEL=deepseek/deepseek-v4-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-redis-password
NEXT_PUBLIC_CLOUDFRONT_URL=https://cdn.example.com
NEXT_PUBLIC_STOREFRONT_IMAGE_ORIGINS=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=replace-me
STOREFRONT_META_PROXY_SECRET=replace-with-a-shared-long-random-secret
NEXT_PUBLIC_GA_MEASUREMENT_ID=replace-me
# Optional. The current production deployment intentionally leaves TikTok disabled.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
SENTRY_DSN_STOREFRONT=
NEXT_PUBLIC_SENTRY_DSN_STOREFRONT=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=replace-me
SENTRY_TRACES_SAMPLE_RATE_STOREFRONT=0.1
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE_STOREFRONT=0.1
