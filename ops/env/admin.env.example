NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://bricadmin_admin:replace-with-admin-password@postgres:5432/bricadmin
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-redis-password
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
BETTER_AUTH_URL=https://admin.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_CLOUDFRONT_DOMAIN=cdn.example.com
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ENDPOINT_URL_S3=
AWS_S3_FORCE_PATH_STYLE=false
ECOTRACK_BASE_URL=https://example.ecotrack/api/v1
ECOTRACK_TOKEN=replace-me
ECOTRACK_EMIR_BASE_URL=https://example.ecotrack/api/v1
ECOTRACK_EMIR_TOKEN=replace-me
STOREFRONT_API_BASE_URL=http://storefront-api-blue:3001
STOREFRONT_BASE_URL=https://bricomaitre.com
NEXT_PUBLIC_STOREFRONT_BASE_URL=https://bricomaitre.com
STOREFRONT_REVALIDATE_SECRET=replace-with-a-shared-long-random-secret
ADMIN_DATABASE_MAINTENANCE_CRON="43 * * * *"
ADMIN_DATABASE_MAINTENANCE_TIMEZONE=Africa/Algiers
ADMIN_REPORTING_REFRESH_CRON="17 3 * * *"
ADMIN_REPORTING_REFRESH_TIMEZONE=Africa/Algiers
ADMIN_META_ADS_SYNC_ENABLED=false
ADMIN_SEARCH_CONSOLE_SYNC_ENABLED=false
ADMIN_SEARCH_CONSOLE_SYNC_CRON="37 4 * * *"
ADMIN_SEARCH_CONSOLE_SYNC_TIMEZONE="Africa/Algiers"
MARKETING_GOOGLE_DESTINATION_ENABLED=true
MARKETING_TIKTOK_DESTINATION_ENABLED=false
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_BASE64=
SEARCH_CONSOLE_ANALYTICS_ENDPOINT=https://www.googleapis.com/webmasters/v3/sites
SEARCH_CONSOLE_INSPECTION_ENDPOINT=https://searchconsole.googleapis.com/v1/urlInspection/index:inspect
SEARCH_CONSOLE_SITE_URL="sc-domain:bricomaitre.com"
SEARCH_CONSOLE_SITE_ORIGIN="https://bricomaitre.com"
ADMIN_META_ADS_SYNC_CRON="17 */6 * * *"
ADMIN_META_ADS_SYNC_TIMEZONE=Africa/Algiers
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_GRAPH_API_VERSION=v25.0
META_ADS_GRAPH_API_ORIGIN=https://graph.facebook.com
ECOTRACK_SYNC_CRON="0 3 * * *"
ECOTRACK_SYNC_TIMEZONE=Africa/Algiers
ECOTRACK_ORDER_SYNC_CRON="*/15 * * * *"
ECOTRACK_ORDER_SYNC_TIMEZONE=Africa/Algiers
PRODUCT_CATALOG_FEED_DEBOUNCE_MS=120000
PRODUCT_CATALOG_FEED_TOKEN=
PRODUCT_EXPORT_BATCH_SIZE=250
PRODUCT_EXPORT_BATCH_DELAY_MS=100
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# To use ExperientialLabs, set AI_PROVIDER=experientiallabs and EXPLABS_API_KEY.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://bricomaitre.com
OPENROUTER_APP_TITLE=Bricomaitre
AI_ADMIN_MODEL=
AI_STOREFRONT_MODEL=
AI_STOREFRONT_FALLBACK_MODEL=deepseek/deepseek-v4-flash
AI_CONTENT_MODEL=
# Applies to bounded AI jobs such as content generation. Admin chat remains
# connected until the Operator leaves or closes the request.
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_ADMIN_INPUT_COST_PER_1M_USD=
AI_ADMIN_OUTPUT_COST_PER_1M_USD=
AI_STOREFRONT_INPUT_COST_PER_1M_USD=
AI_STOREFRONT_OUTPUT_COST_PER_1M_USD=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=replace-me
