BRIC_ENV_DIR=/srv/bric/env
BRIC_ADMIN_DOMAIN=admin.example.com
BRIC_ADMIN_CERT_NAME=admin.example.com
BRIC_API_DOMAIN=api.example.com
BRIC_API_CERT_NAME=api.example.com
BRIC_STOREFRONT_DOMAIN=example.com
BRIC_STOREFRONT_APEX_DOMAIN=example.com
BRIC_STOREFRONT_CERT_NAME=example.com
BRIC_RUNTIME_DIR=/srv/bric/runtime
BRIC_CERTBOT_WEBROOT_DIR=/srv/bric/runtime/certbot-webroot
BRIC_IMAGE_STATE_FILE=/srv/bric/runtime/images.env
POSTGRES_DB=bricadmin
POSTGRES_USER=bricadmin_owner
# Required. Generate a long random value before rendering or starting the stack.
POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=bricadmin_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_STOREFRONT_USER=bricadmin_storefront
POSTGRES_STOREFRONT_PASSWORD=
# Required by Redis and every application process. Use a URL-safe random value.
REDIS_PASSWORD=
BACKUP_DIR=/srv/bric/backups
BACKUP_S3_URI=s3://your-private-backup-bucket/bricadmin
BACKUP_LOCAL_KEEP_DAYS=14
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_SESSION_TOKEN=
BACKUP_AWS_PROFILE=
BRIC_POSTGRES_RESTORE_MEMORY=1024m
BRIC_POSTGRES_RESTORE_CPUS=1
BACKUP_RESTORE_MAX_AGE_HOURS=36
BACKUP_RESTORE_MIN_PRODUCTS=1
BACKUP_RESTORE_MIN_ORDERS=1
# Required by the scheduled restore drill. Use a dead-man check URL that accepts /start and /fail.
BACKUP_RESTORE_CHECKIN_URL=
AWS_REGION=eu-west-3
BRIC_LOG_MAX_SIZE=20m
BRIC_LOG_MAX_FILES=5
BRIC_STOREFRONT_MEMORY_ALERT_PERCENT=85
BRIC_NEXT_FETCH_CACHE_MAX_BYTES=268435456
BRIC_NEXT_FETCH_CACHE_MAX_AGE_SECONDS=604800
BRIC_NEXT_FETCH_CACHE_PRUNE_INTERVAL_SECONDS=900

# Production deploys pull immutable GHCR digest refs from BRIC_IMAGE_STATE_FILE.
# Run ops/scripts/bootstrap-registry-runtime.sh once on the VPS after configuring
# GHCR_USERNAME and GHCR_READ_TOKEN for a read-only packages token.
