NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://bricadmin_storefront:replace-with-storefront-password@postgres:5432/bricadmin
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-redis-password
ECOTRACK_BASE_URL=https://example.ecotrack/api/v1
ECOTRACK_TOKEN=replace-me
SITE_URL=https://bricomaitre.com
STOREFRONT_API_DEPLOY_TOKEN=replace-me
STOREFRONT_REVALIDATE_SECRET=replace-with-a-long-random-secret
STOREFRONT_META_PROXY_SECRET=replace-with-a-shared-long-random-secret
META_PIXEL_ID=replace-with-meta-pixel-id
META_CONVERSIONS_API_TOKEN=replace-with-meta-access-token
META_GRAPH_API_VERSION=v25.0
META_TEST_EVENT_CODE=replace-me
META_DEPLOY_VERIFY_ENABLED=1
GOOGLE_ANALYTICS_MEASUREMENT_ID=replace-me
GOOGLE_ANALYTICS_API_SECRET=replace-me
MARKETING_GOOGLE_DESTINATION_ENABLED=true
# Optional. Leave both empty to disable TikTok delivery.
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_ACCESS_TOKEN=
MARKETING_TIKTOK_DESTINATION_ENABLED=false
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_CLOUDFRONT_DOMAIN=cdn.example.com
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=replace-me
SENTRY_DSN_STOREFRONT_API=
SENTRY_TRACES_SAMPLE_RATE_STOREFRONT_API=0.05
