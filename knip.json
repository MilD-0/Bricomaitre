{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreUnresolved": ["next"],
  "workspaces": {
    "ops": {
      "entry": [
        "scripts/*.mjs!",
        "demo/mock-services.mjs!",
        "demo/release/*.mjs!",
        "dev/cli.mjs!",
        "dev/qa.mjs!",
        "dev/supervisor.mjs!",
        "demo/scripts/*.mjs!"
      ],
      "project": ["**/*.{ts,mjs}!", "!tests/**!"]
    },
    "apps/admin": {
      "entry": [
        "instrumentation*.ts!",
        "scripts/**/*.ts!",
        "tools/legacy-data/**/*.ts!",
        "app/**/{page,layout,route,loading,error,global-error,not-found,default,robots,sitemap,manifest}.{ts,tsx}!",
        "drizzle.schemas.ts!",
        "next.config.ts!"
      ],
      "project": [
        "**/*.{ts,tsx,mjs,css}!",
        "!**/*.{test,spec}.{ts,tsx}!",
        "!test/**!",
        "!tests/**!"
      ],
      "next": {
        "config": []
      },
      "ignoreDependencies": ["esbuild"]
    },
    "apps/storefront-api": {
      "entry": [
        "instrumentation*.ts!",
        "scripts/**/*.ts!",
        "app/**/{page,layout,route,loading,error,global-error,not-found,default,robots,sitemap,manifest}.{ts,tsx}!",
        "next.config.ts!"
      ],
      "project": ["**/*.{ts,tsx,mjs}!", "!**/*.{test,spec}.{ts,tsx}!", "!test/**!", "!tests/**!"],
      "next": {
        "config": []
      },
      "ignoreDependencies": ["esbuild"]
    },
    "apps/storefront": {
      "entry": [
        "instrumentation*.ts!",
        "app/**/{page,layout,route,loading,error,global-error,not-found,default,robots,sitemap,manifest}.{ts,tsx}!",
        "scripts/**/*.ts!",
        "next.config.ts!",
        "test/fixture-storefront-api.mjs"
      ],
      "ignoreDependencies": ["@fontsource-variable/inter", "@fontsource/ibm-plex-sans-arabic"],
      "project": [
        "**/*.{ts,tsx,mjs,css}!",
        "!**/*.{test,spec}.{ts,tsx}!",
        "!test/**!",
        "!tests/**!"
      ],
      "next": {
        "config": []
      }
    },
    ".": {
      "entry": ["eslint.base.mjs!"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["flock"]
}
