{
  "name": "bricomaitre-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "dev:admin": "pnpm --filter @bric/admin dev:full",
    "dev:storefront-api": "pnpm --filter @bric/storefront-api dev",
    "dev:storefront": "pnpm --filter @bric/storefront dev",
    "worker:admin": "pnpm --filter @bric/admin worker",
    "worker:storefront-meta": "pnpm --filter @bric/storefront-api worker:meta",
    "build:admin": "pnpm --filter @bric/admin build",
    "build:storefront-api": "pnpm --filter @bric/storefront-api build",
    "build:storefront": "pnpm --filter @bric/storefront build",
    "build:apps": "pnpm build:storefront-api && pnpm build:admin && pnpm build:storefront",
    "test:admin": "pnpm --filter @bric/admin test",
    "test:admin:integration": "pnpm --filter @bric/admin test:integration",
    "test:services": "pnpm --filter @bric/admin test:services",
    "test:ops": "pnpm --filter @bric/ops test",
    "test:storefront-api": "pnpm --filter @bric/storefront-api test",
    "test:storefront": "pnpm --filter @bric/storefront test",
    "test:storefront:integration": "pnpm --filter @bric/storefront test:integration",
    "test:storefront:browser": "pnpm --filter @bric/storefront test:browser",
    "test:packages": "pnpm --filter @bric/ai-core test && pnpm --filter @bric/runtime test && pnpm --filter @bric/storefront-core test",
    "test:ci": "pnpm test:ops && pnpm test:packages && pnpm test:admin && pnpm test:admin:integration && pnpm test:storefront-api && pnpm test:storefront && pnpm test:storefront:integration && pnpm test:storefront:browser && pnpm test:storefront:performance",
    "lint": "pnpm --filter './apps/*' --parallel lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dead-code:check": "knip",
    "analyze:storefront": "pnpm --filter @bric/storefront build",
    "ops:up": "docker compose -f ops/docker/compose.prod.yml up -d",
    "ops:down": "docker compose -f ops/docker/compose.prod.yml down",
    "ops:restart": "docker compose -f ops/docker/compose.prod.yml restart",
    "ops:logs": "docker compose -f ops/docker/compose.prod.yml logs -f --tail=200",
    "ops:wait:storefront-api": "bash -lc 'source ops/scripts/blue-green.sh && bash ops/scripts/wait-for-health.sh \"$(service_name storefront-api \"$(get_active_slot)\")\"'",
    "ops:migrate": "bash ops/scripts/run-admin-migrations.sh",
    "ops:smoke": "bash ops/scripts/smoke-check.sh",
    "ops:deploy": "bash ops/scripts/deploy.sh",
    "ops:rollback": "bash ops/scripts/rollback.sh",
    "ops:render-nginx": "bash ops/scripts/render-nginx-config.sh"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "typescript": "6.0.2"
  }
}
