{
  "name": "@bric/storefront",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build --webpack",
    "start": "bash ../../ops/scripts/hydrate-next-standalone.sh apps/storefront && node ../../ops/scripts/start-next-standalone.mjs --app-dir . --nested-dir apps/storefront --default-port 3003",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit-node && vitest run --project browser-unit-jsdom && vitest run --project component-jsdom",
    "test:contract": "vitest run --project app-contract-node",
    "test:integration": "pnpm test:contract && vitest run --project component-integration-jsdom",
    "test:browser": "playwright test --project=chromium --project=mobile-iphone --project=mobile-android",
    "test:performance": "BRIC_PLAYWRIGHT_SERVER=production playwright test --project=performance",
    "eval:ai:live": "tsx scripts/run-ai-evals.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@bric/ai-core": "workspace:*",
    "@bric/runtime": "workspace:*",
    "@bric/storefront-core": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@sentry/nextjs": "10.70.0",
    "ai": "^7.0.66",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "photoswipe": "^5.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "web-haptics": "^0.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
