{
  "name": "@bric/storefront",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build --webpack",
    "start": "bash ../../ops/scripts/hydrate-next-standalone.sh apps/storefront && node ../../ops/scripts/start-next-standalone.mjs --app-dir . --nested-dir apps/storefront --default-port 3003",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit-node --maxWorkers=2 && vitest run --project browser-unit-jsdom --maxWorkers=2 && vitest run --project component-jsdom --maxWorkers=2",
    "test:coverage": "vitest run --project unit-node --project browser-unit-jsdom --project component-jsdom --coverage --maxWorkers=2",
    "test:contract": "vitest run --project app-contract-node --maxWorkers=2",
    "test:integration": "pnpm test:contract && vitest run --project component-integration-jsdom --maxWorkers=2",
    "test:browser": "playwright test --project=chromium --project=mobile-iphone --project=mobile-android",
    "test:performance": "BRIC_PLAYWRIGHT_SERVER=production playwright test --project=performance",
    "capture:design-baseline": "playwright test --project=design-baseline",
    "eval:ai": "tsx scripts/run-ai-evals.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@bric/ai-core": "workspace:*",
    "@bric/runtime": "workspace:*",
    "@bric/storefront-core": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@sentry/nextjs": "10.73.0",
    "ai": "^7.0.90",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "photoswipe": "^5.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "web-haptics": "^0.0.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
