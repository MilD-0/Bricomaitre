{
  "name": "@bric/admin",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "dev:full": "tsx scripts/run-development.ts",
    "build": "next build",
    "build:db-tasks": "node ../../ops/scripts/build-worker.mjs apps/admin/scripts/run-db-migrations.ts apps/admin/dist/run-db-migrations.cjs && node ../../ops/scripts/build-worker.mjs apps/admin/scripts/verify-db-migrations.ts apps/admin/dist/verify-db-migrations.cjs && node ../../ops/scripts/build-worker.mjs apps/admin/scripts/refresh-release-reporting.ts apps/admin/dist/refresh-release-reporting.cjs",
    "build:worker": "node ../../ops/scripts/build-worker.mjs apps/admin/scripts/run-background-workers.ts apps/admin/dist/run-background-workers.cjs && ADMIN_WORKER_BOOTSTRAP_CHECK=1 node dist/run-background-workers.cjs",
    "start": "bash ../../ops/scripts/hydrate-next-standalone.sh apps/admin && node ../../ops/scripts/start-next-standalone.mjs --app-dir . --nested-dir apps/admin --default-port 3000",
    "worker": "tsx scripts/run-background-workers.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:baseline": "tsx scripts/baseline-db-migrations.ts",
    "db:migrate": "tsx scripts/run-db-migrations.ts",
    "db:verify": "tsx scripts/verify-db-migrations.ts",
    "db:push": "tsx scripts/guarded-db-push.ts",
    "db:studio": "drizzle-kit studio",
    "legacy:import-mongo": "tsx tools/legacy-data/import-legacy-mongo.ts",
    "legacy:import-mongo:dry": "tsx tools/legacy-data/import-legacy-mongo.ts --dry-run",
    "db:migrate-order-delivery": "tsx scripts/migrate-order-delivery.ts",
    "db:migrate-order-statuses": "tsx scripts/migrate-order-statuses.ts",
    "db:normalize-slugs": "tsx scripts/normalize-slugs.ts",
    "test": "vitest run --project unit-node --maxWorkers=2 && vitest run --project component-jsdom --maxWorkers=2",
    "test:watch": "vitest --project unit-node --project component-jsdom --maxWorkers=2",
    "test:coverage": "vitest run --project unit-node --project component-jsdom --coverage",
    "test:contract": "vitest run --project route-contract-node",
    "test:integration": "pnpm test:contract",
    "test:services": "vitest run --project service-integration-node",
    "test:redis:ai": "vitest run --project redis-integration-node --maxWorkers=1",
    "eval:ai:wide": "tsx admin-ai-wide-eval.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@better-auth/drizzle-adapter": "1.6.29",
    "@bric/ai-core": "workspace:*",
    "@bric/db": "workspace:*",
    "@bric/runtime": "workspace:*",
    "@bric/storefront-core": "workspace:*",
    "@hookform/resolvers": "^5.9.0",
    "@sentry/nextjs": "10.70.0",
    "@sentry/node": "10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@uppy/core": "^5.2.0",
    "@uppy/xhr-upload": "^5.2.0",
    "ai": "^7.0.66",
    "better-auth": "1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^28.1.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
